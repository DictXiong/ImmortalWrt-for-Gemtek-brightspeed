 	for line in $text; do
 		case "$line" in
 			*=*)
 				k="${line%%=*}"
 				v="${line#*=}"
 				[ -z "$k" ] && continue
 				[ "$first" = "1" ] || fields="$fields,"
 				fields="$fields\"$(json_escape "$k")\":\"$(json_escape "$v")\""
 				first=0
 				[ "$k" = "wan_mac" ] && wan="$v"
 				[ "$k" = "lan_mac" ] && lan="$v"
