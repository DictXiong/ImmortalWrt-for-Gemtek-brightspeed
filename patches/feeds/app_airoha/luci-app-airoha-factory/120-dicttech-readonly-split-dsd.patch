-	printf '{"mtd":"%s","writable":%s,"fields":%s,"ubi":{"wan":"%s","lan":"%s"},"wan":"%s","lan":"%s","lan_derived":"%s","oui_derived":"%s","env":{"ethaddr":"%s","oui":"%s","oui_stored":%s},"env_ready":%s}\n' \
+	printf '{"mtd":"%s","writable":%s,"fields":%s,"ubi":{"wan":"%s","lan":"%s"},"wan":"%s","lan":"%s","lan_derived":"%s","oui_derived":"%s","env":{"ethaddr":"%s","oui":"%s","oui_stored":%s},"env_ready":%s,"layout":"%s","readable":true,"metadata":%s}\n' \
 		"$dev" "$writable" "$fields" "$ubi_wan" "$ubi_lan" \
 		"$wan" "$lan" "$lan_derived" "$oui_derived" \
-		"$uboot_ethaddr" "$uboot_oui" "$uboot_oui_stored" "$env_ready"
+		"$uboot_ethaddr" "$uboot_oui" "$uboot_oui_stored" "$env_ready" "$FACTORY_LAYOUT" "$(device_metadata)"
 
