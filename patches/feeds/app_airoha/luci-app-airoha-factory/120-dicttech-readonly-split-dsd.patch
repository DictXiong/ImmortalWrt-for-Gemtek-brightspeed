diff --git a/luci-app-airoha-factory/root/usr/libexec/rpcd/luci.airoha_factory b/luci-app-airoha-factory/root/usr/libexec/rpcd/luci.airoha_factory
index ec1897a..167d28e 100755
--- a/luci-app-airoha-factory/root/usr/libexec/rpcd/luci.airoha_factory
+++ b/luci-app-airoha-factory/root/usr/libexec/rpcd/luci.airoha_factory
@@ -1,659 +1,747 @@
 #!/bin/sh
 # LuCI backend for the Airoha XR1710G factory provisioning editor.
 #
 # The "vendor" MTD partition (mtd0) carries two regions we care about:
 #
 #   * Factory text block  @ offset 0x400000 (FACTORY_OFFSET)
 #       A simple key=value text area (admin credentials, MAC addresses,
 #       serial number, Wi-Fi defaults, ...) followed by 0xff padding and a
 #       few binary blobs.  We only ever edit three keys here:
 #         - wan_mac
 #         - lan_mac   (= wan_mac + 1 unless overridden)
 #         - serial_number
 #
 #   * U-Boot environment  @ offset 0x200000 (ENV_OFFSET)
 #       A standard U-Boot env (4-byte CRC32 + NUL separated name=value).
 #       We keep two variables in sync with the addresses:
 #         - ethaddr  = wan_mac by default (may be overridden per save)
 #         - oui      = first three octets of ethaddr, formatted 00:AA:BB
 #
 # The OpenWrt U-Boot layout backs up the whole original DSD partition into
 # the UBI "factory" volume.  In that layout the live MAC cells are the DSD
 # text fields at 0x6c/0x86 and the MT7996 EEPROM/calibration is preserved
 # at DSD offset 0x5000, all inside the same UBI volume.  This backend
 # rewrites the DSD text and MAC fields as one whole-volume UBI update.
 # "factory_storage" and "ubi_factory" are only DTS phandle labels; both
 # refer to this single runtime UBI volume named "factory".
 #
 # Linkage rules (the "联动" the UI implements):
 #   editing WAN MAC  ->  LAN MAC = WAN+1, ethaddr = WAN (both overridable)
 #   ethaddr          ->  OUI = first3(ethaddr)
 #
 # The legacy XR1710G layout edits the writable vendor MTD partition.  The
 # OpenWrt U-Boot layout has no vendor MTD partition at all: everything is
 # kept in the UBI factory volume.
 #
 # The vendor environment has nothing to do with the UBI "ubootenv"/"ubootenv2"
 # volumes used by the chainloader U-Boot, so it gets its own fw_env config.
 # Never touch the shared /etc/fw_env.config: uboot-envtools owns it and
 # fw_env only honours the first two entries of a config file, so prepending a
 # /dev/mtd0 entry makes every bare fw_printenv/fw_setenv call fail with
 # "Incompatible flash types!".
 
 set -f
 . /usr/share/libubox/jshn.sh
 
 MTD_LABEL="vendor"
 FACTORY_OFFSET=4194304          # 0x400000
 BLOCK_SIZE=131072               # 128 KiB erase block
 TEXT_LIMIT=4096                 # text region is kept within the first 0x1000
 FACTORY_LAYOUT="legacy"
 UBI_WAN_OFF=20480               # 0x5000
 UBI_LAN_OFF=24576               # 0x6000
 UBI_MAC_SIZE=6
 ENV_OFFSET=2097152              # 0x200000
 ENV_SIZE=16384                  # 0x4000
 ENV_SECTOR=131072               # 0x20000
 UBOOT_ENV_CONF="/etc/fw_env.factory.config"
 NL='
 '
 
-case "$(board_name 2>/dev/null)" in
+BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
+case "$BOARD" in
 gemtek,xr1710g-ubi)
 	FACTORY_LAYOUT="dsd"
 	UBI_WAN_OFF=108                # DSD wan_mac value in the 2 MiB main-data backup
 	UBI_LAN_OFF=134                # DSD lan_mac value in the 2 MiB main-data backup
 	UBI_MAC_SIZE=17
 	;;
 esac
 
 find_mtd_dev()
 {
-	local id size erase name d i n found=""
+	local id size erase name d i n found="" label="${1:-$MTD_LABEL}"
 
 	# Pathname expansion is disabled globally with `set -f`, so parse the
 	# kernel's MTD table first instead of relying on an unexpanded sysfs glob.
 	if [ -r /proc/mtd ]; then
 		while read -r id size erase name; do
-			[ "$name" = "\"$MTD_LABEL\"" ] || continue
+			[ "$name" = "\"$label\"" ] || continue
 			id="${id%:}"
 			[ -c "/dev/$id" ] || continue
 			printf '/dev/%s\n' "$id"
 			return 0
 		done < /proc/mtd
 	fi
 
 	# Fall back to sysfs for systems without /proc/mtd. Re-enable pathname
 	# expansion only while collecting MTD class devices.
 	set +f
 	for d in /sys/class/mtd/mtd[0-9]*; do
 		[ -d "$d" ] || continue
 		i="${d##*/mtd}"
 		case "$i" in
 			''|*[!0-9]*) continue ;;
 		esac
 		[ -f "$d/name" ] || continue
 		read -r n < "$d/name"
-		[ "$n" = "$MTD_LABEL" ] && { found="/dev/mtd$i"; break; }
+		[ "$n" = "$label" ] && { found="/dev/mtd$i"; break; }
 	done
 	set -f
 
 	[ -n "$found" ] && [ -c "$found" ] || return 1
 	printf '%s\n' "$found"
 }
 
+# The maintained legacy DTS exposes the original 2 MiB DSD as its own MTD.
+# Its offsets are relative to that partition, never the old aggregate vendor.
+if [ "$BOARD" = gemtek,xr1710g ] && ! find_mtd_dev >/dev/null 2>&1 &&
+   find_mtd_dev dsd >/dev/null 2>&1; then
+	FACTORY_LAYOUT="raw-dsd"
+fi
+
 find_ubi_factory()
 {
 	local ubidev volume d n
 
 	if [ -r /lib/upgrade/nand.sh ]; then
 		. /lib/upgrade/nand.sh
 		ubidev="$(nand_find_ubi ubi 2>/dev/null)" || ubidev=""
 		volume="$(nand_find_volume "$ubidev" factory 2>/dev/null)" || volume=""
 		[ -n "$volume" ] && [ -c "/dev/$volume" ] && {
 			printf '/dev/%s\n' "$volume"
 			return 0
 		}
 	fi
 
 	set +f
 	for d in /sys/class/ubi/ubi[0-9]*_[0-9]*; do
 		[ -d "$d" ] || continue
 		[ -f "$d/name" ] || continue
 		read -r n < "$d/name"
 		[ "$n" = "factory" ] || continue
 		set -f
 		printf '/dev/%s\n' "${d##*/}"
 		return 0
 	done
 	set -f
 	return 1
 }
 
 find_factory_dev()
 {
 	if [ "$FACTORY_LAYOUT" = "dsd" ]; then
 		find_ubi_factory
+	elif [ "$FACTORY_LAYOUT" = "raw-dsd" ]; then
+		find_mtd_dev dsd
 	else
 		find_mtd_dev
 	fi
 }
 
 read_factory_data()
 {
 	local dev="$1" tmp="$2"
 
 	if [ "$FACTORY_LAYOUT" = "dsd" ]; then
 		dd if="$dev" of="$tmp" bs=65536 count=2 2>/dev/null
 	else
 		dd if="$dev" of="$tmp" bs=65536 skip=64 count=2 2>/dev/null
 	fi
 }
 
 mtd_flags()
 {
 	local f="0"
 	[ -r "/sys/class/mtd/${1##*/}/flags" ] && read -r f < "/sys/class/mtd/${1##*/}/flags"
 	echo "$f"
 }
 
 mtd_writable()
 {
 	[ $(( $(mtd_flags "$1") & 0x400 )) -ne 0 ]
 }
 
 json_escape()
 {
 	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
 }
 
 hex_mac()
 {
 	# $1 = offset, $2 = device -> print xx:xx:xx:xx:xx:xx
 	dd if="$2" bs=1 skip="$1" count=6 2>/dev/null \
 		| hexdump -ve '1/1 "%02x:"' | sed 's/:$//'
 }
 
 read_ubi_mac()
 {
 	# $1 = offset, $2 = UBI factory device -> normalize legacy raw or DSD text MACs.
 	local mac
 
 	if [ "$FACTORY_LAYOUT" = "dsd" ]; then
 		mac="$(dd if="$2" bs=1 skip="$1" count="$UBI_MAC_SIZE" 2>/dev/null \
 			| tr -d '\000\377\r\n')"
 		valid_mac "$mac" && mac_lc "$mac"
 	else
 		hex_mac "$1" "$2"
 	fi
 }
 
 mac_to_raw()
 {
 	# $1 = mac string -> 6 raw bytes on stdout
 	printf '%b' "$(echo "$1" | tr -d ':' | sed 's/../\\x&/g')"
 }
 
 mac_to_text()
 {
 	# $1 = mac string -> 17-byte DSD MAC text without newline
 	printf '%s' "$(mac_lc "$1")"
 }
 
 write_ubi_factory_macs()
 {
 	# $1 = UBI factory device, $2 = WAN MAC, $3 = LAN MAC
 	local dev="$1" wan="$2" lan="$3" tmp log
 
 	[ -c "$dev" ] || { printf 'skipped (UBI factory volume not found)'; return 0; }
 
 	if [ "$FACTORY_LAYOUT" = "dsd" ]; then
 		command -v ubiupdatevol >/dev/null 2>&1 || {
 			printf 'skipped (ubiupdatevol unavailable)'
 			return 0
 		}
 
 		tmp="$(mktemp)" || { printf 'failed (unable to create temporary file)'; return 0; }
 		log="/tmp/airoha_factory_ubi.log"
 		if ! dd if="$dev" of="$tmp" bs=4096 2>/dev/null; then
 			rm -f "$tmp"
 			printf 'failed (unable to read UBI factory DSD backup)'
 			return 0
 		fi
 
 		if ! mac_to_text "$wan" | dd of="$tmp" bs=1 seek="$UBI_WAN_OFF" \
 			count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null ||
 		   ! mac_to_text "$lan" | dd of="$tmp" bs=1 seek="$UBI_LAN_OFF" \
 			count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null; then
 			rm -f "$tmp"
 			printf 'failed (unable to patch UBI factory DSD backup)'
 			return 0
 		fi
 
 		if ubiupdatevol "$dev" "$tmp" >"$log" 2>&1; then
 			printf 'UBI factory DSD backup updated (WAN/LAN text MACs)'
 		else
 			printf 'failed (ubiupdatevol: %s)' \
 				"$(tr '\n' ' ' < "$log" 2>/dev/null)"
 		fi
 
 		rm -f "$tmp" "$log"
 	else
 		mac_to_raw "$wan" | dd of="$dev" bs=1 seek="$UBI_WAN_OFF" \
 			count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null
 		mac_to_raw "$lan" | dd of="$dev" bs=1 seek="$UBI_LAN_OFF" \
 			count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null
 		printf 'UBI factory volume updated (legacy raw WAN/LAN MACs)'
 	fi
 }
 
 write_ubi_factory_fields()
 {
 	# $1 = UBI factory device, $2 = WAN MAC, $3 = LAN MAC, $4 = serial
 	local dev="$1" wan="$2" lan="$3" serial="$4"
 	local tmp orig headf bodyf newfile newblk n rem log
 
 	[ -c "$dev" ] || { printf 'failed (UBI factory volume not found)'; return 0; }
 	command -v ubiupdatevol >/dev/null 2>&1 || {
 		printf 'failed (ubiupdatevol unavailable)'
 		return 0
 	}
 
 	tmp="$(mktemp)" || { printf 'failed (unable to create temporary file)'; return 0; }
 	orig="$(mktemp)" || { rm -f "$tmp"; printf 'failed (unable to create temporary file)'; return 0; }
 	headf="$(mktemp)" || { rm -f "$tmp" "$orig"; printf 'failed (unable to create temporary file)'; return 0; }
 	bodyf="$(mktemp)" || { rm -f "$tmp" "$orig" "$headf"; printf 'failed (unable to create temporary file)'; return 0; }
 	newfile="${tmp}.new"
 	log="/tmp/airoha_factory_ubi.log"
 
 	if ! dd if="$dev" of="$tmp" bs=4096 2>/dev/null; then
 		rm -f "$tmp" "$orig" "$headf" "$bodyf"
 		printf 'failed (unable to read UBI factory DSD backup)'
 		return 0
 	fi
 
 	head -c "$TEXT_LIMIT" "$tmp" | tr -d '\000\377' > "$orig"
 
 	newblk=""
 	while IFS= read -r line; do
 		case "$line" in
 			wan_mac=*)       newblk="${newblk}wan_mac=${wan}${NL}"; continue ;;
 			lan_mac=*)       newblk="${newblk}lan_mac=${lan}${NL}"; continue ;;
 			serial_number=*) newblk="${newblk}serial_number=${serial}${NL}"; continue ;;
 			*)               [ -n "$line" ] && newblk="${newblk}${line}${NL}" ;;
 		esac
 	done < "$orig"
 	grep -q '^wan_mac=' "$orig"       || newblk="${newblk}wan_mac=${wan}${NL}"
 	grep -q '^lan_mac=' "$orig"       || newblk="${newblk}lan_mac=${lan}${NL}"
 	grep -q '^serial_number=' "$orig" || newblk="${newblk}serial_number=${serial}${NL}"
 
 	n=${#newblk}
 	if [ "$n" -gt "$TEXT_LIMIT" ]; then
 		rm -f "$tmp" "$orig" "$headf" "$bodyf"
 		printf 'failed (DSD text block too large: %s > %s bytes)' "$n" "$TEXT_LIMIT"
 		return 0
 	fi
 
 	{
 		printf '%s' "$newblk"
 		rem=$(( TEXT_LIMIT - n ))
 		[ "$rem" -gt 0 ] && dd if=/dev/zero bs=1 count="$rem" 2>/dev/null | tr '\0' '\377'
 	} > "$headf"
 	dd if="$tmp" of="$bodyf" bs=1 skip="$TEXT_LIMIT" 2>/dev/null
 	cat "$headf" "$bodyf" > "$newfile"
 
 	if ! mac_to_text "$wan" | dd of="$newfile" bs=1 seek="$UBI_WAN_OFF" \
 		count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null ||
 	   ! mac_to_text "$lan" | dd of="$newfile" bs=1 seek="$UBI_LAN_OFF" \
 		count="$UBI_MAC_SIZE" conv=notrunc 2>/dev/null; then
 		rm -f "$tmp" "$orig" "$headf" "$bodyf" "$newfile"
 		printf 'failed (unable to patch UBI factory DSD backup)'
 		return 0
 	fi
 
 	if ubiupdatevol "$dev" "$newfile" >"$log" 2>&1; then
 		printf 'UBI factory DSD backup updated (text fields and WAN/LAN MACs)'
 	else
 		printf 'failed (ubiupdatevol: %s)' "$(tr '\n' ' ' < "$log" 2>/dev/null)"
 	fi
 
 	rm -f "$tmp" "$orig" "$headf" "$bodyf" "$newfile" "$log"
 }
 
 valid_mac()
 {
 	echo "$1" | grep -qiE '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'
 }
 
 # strict MAC validation: unicast, not all-zero and not broadcast
 valid_mac_strict()
 {
 	local h f
 	valid_mac "$1" || return 1
 	h="$(echo "$1" | tr -d ':' | tr 'a-f' 'A-F')"
 	[ "$h" = "000000000000" ] && return 1
 	[ "$h" = "FFFFFFFFFFFF" ] && return 1
 	f=$(echo "$1" | cut -d: -f1)
 	[ $(( 0x$f & 1 )) -eq 0 ] || return 1
 	return 0
 }
 
 mac_lc()
 {
 	echo "$1" | tr 'A-F' 'a-f'
 }
 
 # first three octets of a MAC, formatted 00:AA:BB
 derive_oui()
 {
 	local h
 	h="$(echo "$1" | tr -d ':')"
 	[ ${#h} -lt 6 ] && { echo ""; return; }
 	echo "$h" | cut -c1-6 | sed 's/../&:/g; s/:$//'
 }
 
 # MAC + 1 with carry (returns original on bad input)
 mac_plus1()
 {
 	local hex b0 b1 b2 b3 b4 b5
 	hex="$(echo "$1" | tr -d ':')"
 	[ ${#hex} -ne 12 ] && { echo "$1"; return; }
 	set -- $(printf '%s' "$hex" | sed 's/../0x& /g')
 	b0=$(($1)); b1=$(($2)); b2=$(($3))
 	b3=$(($4)); b4=$(($5)); b5=$(($6))
 	b5=$((b5 + 1))
 	[ "$b5" -gt 255 ] && { b5=0; b4=$((b4 + 1)); }
 	[ "$b4" -gt 255 ] && { b4=0; b3=$((b3 + 1)); }
 	[ "$b3" -gt 255 ] && { b3=0; b2=$((b2 + 1)); }
 	[ "$b2" -gt 255 ] && { b2=0; b1=$((b1 + 1)); }
 	[ "$b1" -gt 255 ] && { b1=0; b0=$((b0 + 1)); }
 	printf '%02x:%02x:%02x:%02x:%02x:%02x' "$b0" "$b1" "$b2" "$b3" "$b4" "$b5"
 }
 
 # make sure the factory-specific fw_env config points at the embedded U-Boot env
 ensure_env_conf()
 {
 	local dev
 	if [ "$FACTORY_LAYOUT" = "dsd" ]; then
 		[ -r /etc/fw_env.config ] || return 1
 		UBOOT_ENV_CONF="/etc/fw_env.config"
 		return 0
 	fi
 
 	dev="$(find_mtd_dev)" || dev="/dev/mtd0"
 	[ -r "$UBOOT_ENV_CONF" ] && awk -v dev="$dev" '
 		/^[[:space:]]*(#|$)/ { next }
 		$1 == dev && tolower($2) == "0x200000" &&
 			tolower($3) == "0x4000" && tolower($4) == "0x20000" {
 			found = 1
 			exit
 		}
 		END { exit found ? 0 : 1 }
 	' "$UBOOT_ENV_CONF" && return 0
 	[ -w /etc ] || return 1
 	{
 		printf '# Airoha XR1710G U-Boot environment\n'
 		printf '%s 0x200000 0x4000 0x20000\n' "$dev"
 	} > "$UBOOT_ENV_CONF" 2>/dev/null
 }
 
 uboot_env_var()
 {
 	local var="$1" val
 	ensure_env_conf || return 1
 	command -v fw_printenv >/dev/null 2>&1 || return 1
 	val="$(fw_printenv -c "$UBOOT_ENV_CONF" -n "$var" 2>/dev/null)"
 	[ -z "$val" ] && val="$(fw_printenv -c "$UBOOT_ENV_CONF" "$var" 2>/dev/null | sed "s/^${var}=//")"
 	[ -n "$val" ] && { printf '%s' "$val"; return 0; }
 	return 1
 }
 
+# Whitelist public runtime metadata. Do not read passwords, deployment hashes,
+# private host identities or the unfiltered factory text into the status reply.
+device_metadata()
+{
+	local data hostname model kernel board distribution version revision description bridge
+	data="$(ubus -t 2 call system board 2>/dev/null)"
+	json_load "$data" >/dev/null 2>&1 && {
+		json_get_var hostname hostname; json_get_var model model
+		json_get_var kernel kernel; json_get_var board board_name
+		json_select release >/dev/null 2>&1 && {
+			json_get_var distribution distribution; json_get_var version version
+			json_get_var revision revision; json_get_var description description
+		}
+	}
+	[ ! -r /sys/class/net/br-lan/address ] || read -r bridge < /sys/class/net/br-lan/address
+	json_init
+	json_add_string board_name "${board:-$BOARD}"
+	json_add_string hostname "$hostname"; json_add_string model "$model"
+	json_add_string kernel "$kernel"; json_add_string distribution "$distribution"
+	json_add_string version "$version"; json_add_string revision "$revision"
+	json_add_string description "$description"; json_add_string bridge_mac "$bridge"
+	json_dump
+}
+
+readonly_status()
+{
+	local dev="$1" error="$2" tmp line key value fields readable=0
+	local wan="" lan="" serial="" metadata
+	metadata="$(device_metadata)"
+	if [ -n "$dev" ] && [ -z "$error" ]; then
+		tmp="$(mktemp)" || return 1
+		# Only the provisioning text is needed; EEPROM/calibration stays unread.
+		if dd if="$dev" of="$tmp" bs=4096 count=1 2>/dev/null &&
+		   [ "$(wc -c < "$tmp" | tr -d ' ')" = 4096 ]; then
+			readable=1
+			while IFS= read -r line; do
+				case "$line" in *=*) ;; *) continue;; esac
+				key="${line%%=*}"; value="${line#*=}"
+				case "$key" in
+				 wan_mac) valid_mac_strict "$value" && wan="$(mac_lc "$value")";;
+				 lan_mac) valid_mac_strict "$value" && lan="$(mac_lc "$value")";;
+				 serial_number)
+				  case "$value" in *[![:print:]]*) continue;; esac
+				  [ -n "$value" ] && [ "${#value}" -le 128 ] && serial="$value";;
+				esac
+			done <<FACTORY_TEXT
+$(tr -d '\000\377\r' < "$tmp")
+FACTORY_TEXT
+			[ -n "$wan$lan$serial" ] || error="factory provisioning text not recognized"
+		else error="failed to read complete factory text"; fi
+		rm -f "$tmp"
+	fi
+	json_init
+	json_add_string layout "$FACTORY_LAYOUT"; json_add_string mtd "$dev"
+	json_add_boolean readable "$readable"; json_add_boolean writable 0
+	json_add_string readonly_reason "Factory and U-Boot writes are unsupported for this layout."
+	[ -z "$error" ] || json_add_string error "$error"
+	json_add_object fields
+	[ -z "$wan" ] || json_add_string wan_mac "$wan"
+	[ -z "$lan" ] || json_add_string lan_mac "$lan"
+	[ -z "$serial" ] || json_add_string serial_number "$serial"
+	json_close_object
+	json_add_object env; json_add_boolean available 0; json_close_object
+	json_add_boolean env_ready 0
+	# Metadata is produced by jshn in a separate scope; it contains no raw text.
+	fields="$(json_dump)"
+	printf '%s,"metadata":%s}\n' "${fields%\}}" "$metadata"
+}
+
 get_status()
 {
 	local dev tmp text fields first k v
 	local ubi_factory=""
 	local writable=0 ubi_wan="" ubi_lan=""
 	local wan="" lan="" lan_derived="" oui_derived=""
 	local uboot_ethaddr="" uboot_oui="" env_ready=0
 
 	dev="$(find_factory_dev)" || {
 		if [ "$FACTORY_LAYOUT" = "dsd" ]; then
-			printf '{"error":"UBI factory volume not found"}'
+			readonly_status "" "UBI factory volume not found"
 		else
-			printf '{"error":"vendor partition not found"}'
