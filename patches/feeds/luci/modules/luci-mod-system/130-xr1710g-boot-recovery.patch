diff --git a/modules/luci-mod-system/root/usr/libexec/rpcd/xr.boot-recovery b/modules/luci-mod-system/root/usr/libexec/rpcd/xr.boot-recovery
new file mode 100755
index 0000000..ab27d04
--- /dev/null
+++ b/modules/luci-mod-system/root/usr/libexec/rpcd/xr.boot-recovery
@@ -0,0 +1,28 @@
+#!/bin/sh
+
+case "$1:$2" in
+	list:)
+		printf '%s\n' '{"status":{},"reboot_to_uboot":{}}'
+		;;
+	call:status)
+		if [ -x /lib/xr-boot-recovery ]; then
+			exec /lib/xr-boot-recovery status
+		fi
+		printf '%s\n' '{"state":"unsupported","can_reboot_to_uboot":false}'
+		;;
+	call:reboot_to_uboot)
+		. /usr/share/libubox/jshn.sh
+		if [ -x /sbin/reboot-to-uboot ]; then
+			error="$(/sbin/reboot-to-uboot 2>&1)"
+			code=$?
+		else
+			error='XR1710G: boot recovery is not installed'
+			code=1
+		fi
+		json_init
+		json_add_int code "$code"
+		[ "$code" -eq 0 ] || json_add_string error "$error"
+		json_dump
+		;;
+	*) exit 1;;
+esac
