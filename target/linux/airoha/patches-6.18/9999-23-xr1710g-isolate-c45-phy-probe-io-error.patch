From: Codex <codex@localhost>
Subject: net: mdio: isolate a failed XR1710G external PHY ID read

The two external C45 PHYs share the EN7581 switch MDIO bus. A fatal
ID read at either address currently unregisters the entire bus and
prevents the switch from starting. Enumerate both PHYs and tolerate
this error only if the other PHY responds again with its known ID.
Preserve probe deferral and errors from all other registration steps.

--- a/include/linux/fwnode_mdio.h
+++ b/include/linux/fwnode_mdio.h
@@ -16,6 +16,10 @@
 int fwnode_mdiobus_register_phy(struct mii_bus *bus,
 				struct fwnode_handle *child, u32 addr);
 
+int fwnode_mdiobus_register_phy_report(struct mii_bus *bus,
+				      struct fwnode_handle *child, u32 addr,
+				      bool *id_io_error);
+
 #else /* CONFIG_FWNODE_MDIO */
 int fwnode_mdiobus_phy_device_register(struct mii_bus *mdio,
 				       struct phy_device *phy,
@@ -30,6 +34,14 @@
 {
 	return -EINVAL;
 }
+
+static inline int
+fwnode_mdiobus_register_phy_report(struct mii_bus *bus,
+				  struct fwnode_handle *child, u32 addr,
+				  bool *id_io_error)
+{
+	return -EINVAL;
+}
 #endif
 
 #endif /* __LINUX_FWNODE_MDIO_H */
