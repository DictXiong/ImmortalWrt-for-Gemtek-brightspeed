+static bool xr1710g_mdio_peer_responds(struct mii_bus *mdio, int failed_addr)
+{
+	struct phy_device *peer;
+	int peer_addr = failed_addr == 5 ? 8 : 5;
+	u32 id;
+
+	peer = mdiobus_get_phy(mdio, peer_addr);
+	if (!peer || !peer->is_c45)
+		return false;
+
+	id = peer->c45_ids.device_ids[MDIO_MMD_PMAPMD];
+	if (!id || id == U32_MAX)
+		return false;
+
+	if (mdiobus_c45_read(mdio, peer_addr, MDIO_MMD_PMAPMD, MII_PHYSID1) !=
+	    (u16)(id >> 16))
+		return false;
+
+	return mdiobus_c45_read(mdio, peer_addr, MDIO_MMD_PMAPMD, MII_PHYSID2) ==
+	       (u16)id;
+}
