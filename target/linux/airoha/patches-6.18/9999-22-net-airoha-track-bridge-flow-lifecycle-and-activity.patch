+
+static int airoha_ppe_bridge_activity(struct airoha_ppe *ppe,
+				      struct switchdev_notifier_fdb_activity_info *info)
+{
+	struct net_device *dev = info->info.dev;
+	struct net_device *master;
+	unsigned long hash;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(dev);
+	if (!master || !netif_is_bridge_master(master))
+		goto unlock;
+
+	spin_lock_bh(&ppe_lock);
+	for_each_set_bit(hash, ppe->bridge_binding_valid,
+			 airoha_ppe_get_total_num_entries(ppe)) {
+		struct airoha_bridge_binding *binding = &ppe->bridge_bindings[hash];
+		struct airoha_foe_entry *hwe;
+		unsigned long last_used;
+		int idle;
+
+		if (binding->netns != dev_net(dev)->ns.inum ||
+		    binding->bridge_ifindex != master->ifindex ||
+		    binding->ingress_ifindex != dev->ifindex ||
+		    binding->vid != info->vid ||
+		    !ether_addr_equal(binding->source, info->addr))
+			continue;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+		if (!hwe || FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) !=
+			    AIROHA_FOE_STATE_BIND)
+			continue;
+
+		/* Only a packet's source proves activity at the learned port.
+		 * Sending to a silent destination must not keep its FDB alive.
+		 */
+		idle = airoha_ppe_get_entry_idle_time(ppe, hwe->ib1);
+		last_used = jiffies - (unsigned long)idle * HZ;
+		if (time_after(last_used, info->last_used))
+			info->last_used = last_used;
+	}
+	spin_unlock_bh(&ppe_lock);
+unlock:
+	rcu_read_unlock();
+	return NOTIFY_DONE;
+}
+
+static int airoha_ppe_bridge_event(struct notifier_block *nb,
+				   unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe, bridge_notifier);
+	struct switchdev_notifier_fdb_info *info = ptr;
+	struct net_device *dev = info->info.dev;
+	struct net_device *master;
+	unsigned long hash;
+
+	if (event == SWITCHDEV_FDB_GET_LAST_USED)
+		return airoha_ppe_bridge_activity(ppe, ptr);
+
+	if (event != SWITCHDEV_FDB_ADD_TO_DEVICE &&
+	    event != SWITCHDEV_FDB_DEL_TO_DEVICE)
+		return NOTIFY_DONE;
+	if (!info->addr || info->is_local)
+		return NOTIFY_DONE;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(dev);
+	if (!master || !netif_is_bridge_master(master))
+		goto unlock;
+
+	spin_lock_bh(&ppe_lock);
+	ppe->bridge_generation++;
+	for_each_set_bit(hash, ppe->bridge_binding_valid,
+			 airoha_ppe_get_total_num_entries(ppe)) {
+		struct airoha_bridge_binding *binding = &ppe->bridge_bindings[hash];
+
+		if (binding->netns != dev_net(dev)->ns.inum ||
+		    binding->bridge_ifindex != master->ifindex ||
+		    binding->vid != info->vid)
+			continue;
+		/* Same-port ADD notifications preserve the validated path. A DEL
+		 * always retires it, and an ADD on another port denotes a move.
+		 */
+		if ((ether_addr_equal(binding->source, info->addr) &&
+		     (event == SWITCHDEV_FDB_DEL_TO_DEVICE ||
+		      binding->ingress_ifindex != dev->ifindex)) ||
+		    (ether_addr_equal(binding->destination, info->addr) &&
+		     (event == SWITCHDEV_FDB_DEL_TO_DEVICE ||
+		      binding->egress_ifindex != dev->ifindex)))
+			airoha_ppe_bridge_binding_clear(ppe, hash);
+	}
+	spin_unlock_bh(&ppe_lock);
+unlock:
+	rcu_read_unlock();
+	return NOTIFY_DONE;
+}
+
+static int airoha_ppe_bridge_netdev_event(struct notifier_block *nb,
+					  unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe, netdev_notifier);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	unsigned long hash;
+
+	switch (event) {
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+	case NETDEV_CHANGE:
+	case NETDEV_CHANGEADDR:
+	case NETDEV_CHANGEUPPER:
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	spin_lock_bh(&ppe_lock);
+	ppe->bridge_generation++;
+	for_each_set_bit(hash, ppe->bridge_binding_valid,
+			 airoha_ppe_get_total_num_entries(ppe)) {
+		struct airoha_bridge_binding *binding = &ppe->bridge_bindings[hash];
+
+		if (binding->netns != dev_net(dev)->ns.inum)
+			continue;
+		if (binding->bridge_ifindex == dev->ifindex ||
+		    binding->ingress_ifindex == dev->ifindex ||
+		    binding->egress_ifindex == dev->ifindex)
+			airoha_ppe_bridge_binding_clear(ppe, hash);
+	}
+	spin_unlock_bh(&ppe_lock);
+	return NOTIFY_DONE;
+}
 
