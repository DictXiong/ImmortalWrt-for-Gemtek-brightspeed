+static void airoha_ppe_bridge_binding_clear(struct airoha_ppe *ppe, u32 hash)
+{
+	struct airoha_foe_entry entry, *hwe;
+
+	/* Ordinary TC entries keep their existing parent teardown ownership. */
+	if (!ppe->bridge_bindings[hash].fallback) {
+		clear_bit(hash, ppe->bridge_binding_valid);
+		return;
+	}
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe) {
+		dev_warn_ratelimited(ppe->eth->dev,
+				     "bridge fallback slot %u read failed\n", hash);
+		return;
+	}
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) !=
+	    AIROHA_FOE_STATE_BIND) {
+		clear_bit(hash, ppe->bridge_binding_valid);
+		return;
+	}
+
+	memcpy(&entry, hwe, sizeof(entry));
+	entry.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+	entry.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+			       AIROHA_FOE_STATE_INVALID);
+	/* Use the ordinary unicast teardown path, including NPU statistics. */
+	if (airoha_ppe_foe_commit_entry(ppe, &entry, hash, false)) {
+		set_bit(hash, ppe->bridge_binding_valid);
+		dev_warn_ratelimited(ppe->eth->dev,
+				     "bridge fallback slot %u invalidation failed\n",
+				     hash);
+	}
+}
