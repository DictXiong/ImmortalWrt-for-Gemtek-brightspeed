#!/bin/sh

. /lib/functions/system.sh

case "$(board_name)" in
gemtek,xr1710g|gemtek,xr1710g-ubi) ;;
*) exit 0 ;;
esac

# Defaults only: preserve both GUI and declaratively managed choices on upgrade.
for option in flow_offloading flow_offloading_hw; do
	uci -q get "firewall.@defaults[0].$option" >/dev/null 2>&1 ||
		uci -q set "firewall.@defaults[0].$option=1"
done
uci -q commit firewall

# Service enablement belongs to package installation or the operator. Never
# remove an explicit disable marker or restart networking from a defaults script.
exit 0
