+++ b/xr-boot-recovery.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: LGPL-2.1-only */
+
+#ifndef XR_BOOT_RECOVERY_H
+#define XR_BOOT_RECOVERY_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define XR_RECOVERY_CHOSEN "/sys/firmware/devicetree/base/chosen/dictxiong,boot-recovery"
+#define XR_RECOVERY_READY "/tmp/run/xr-boot-recovery.ready"
+#define XR_RECOVERY_NORMAL_SECONDS 120
+#define XR_RECOVERY_FAILSAFE_SECONDS 60
+
+struct xr_recovery_boot {
+	char token[88];
+	uint8_t image[32];
+	uint32_t seq;
+	uint8_t mode;
+};
+
+static inline int xr_hex_digit(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	return -1;
+}
+
+static inline bool xr_recovery_parse(struct xr_recovery_boot *boot, const char *token)
+{
+	const char *seq = token + 67;
+	char *end;
+	unsigned long n;
+	int hi, lo, i;
+
+	if (strlen(token) < 75 || strncmp(token, "1:", 2) ||
+	    token[66] != ':' || *seq < '1' || *seq > '9')
+		return false;
+
+	for (i = 0; i < 32; i++) {
+		hi = xr_hex_digit(token[2 + i * 2]);
+		lo = xr_hex_digit(token[3 + i * 2]);
+		if (hi < 0 || lo < 0)
+			return false;
+		boot->image[i] = (hi << 4) | lo;
+	}
+
+	errno = 0;
+	n = strtoul(seq, &end, 10);
+	if (errno || n > UINT32_MAX || *end++ != ':')
+		return false;
+	boot->seq = n;
+
+	if (!strcmp(end, "normal"))
+		boot->mode = 0;
+	else if (!strcmp(end, "failsafe"))
+		boot->mode = 1;
+	else
+		return false;
+
+	return true;
+}
+
+static inline bool xr_recovery_read_boot(struct xr_recovery_boot *boot)
+{
+	int fd = open(XR_RECOVERY_CHOSEN, O_RDONLY | O_CLOEXEC);
+	ssize_t n;
+
+	if (fd < 0)
+		return false;
+	n = read(fd, boot->token, sizeof(boot->token));
+	close(fd);
+
+	return n > 0 && (size_t)n < sizeof(boot->token) &&
+	       strnlen(boot->token, n) == (size_t)n - 1 &&
+	       xr_recovery_parse(boot, boot->token);
+}
+
+static inline bool xr_recovery_running(const struct xr_recovery_boot *boot)
+{
+	struct timespec now;
+	int seconds = boot->mode ? XR_RECOVERY_FAILSAFE_SECONDS : XR_RECOVERY_NORMAL_SECONDS;
+
+	/* This budget starts at kernel boot and survives the exec into procd. */
+	return !clock_gettime(CLOCK_BOOTTIME, &now) && now.tv_sec < seconds;
+}
+
+#endif
