@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: LGPL-2.1-only */
+
+#include <mtd/ubi-user.h>
+#include <stdio.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+#include "xr-boot-recovery.h"
+
+#define XR_RECORD_SIZE 48
+#define XR_READY 1
+#define XR_FAILSAFE 1
+
+static uint32_t read_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 |
+	       (uint32_t)p[2] << 8 | p[3];
+}
+
+static void write_be32(uint8_t *p, uint32_t value)
+{
+	p[0] = value >> 24;
+	p[1] = value >> 16;
+	p[2] = value >> 8;
+	p[3] = value;
+}
+
+static uint32_t record_crc(const uint8_t *p)
+{
+	uint32_t crc = UINT32_MAX;
+	int i, bit;
+
+	for (i = 0; i < XR_RECORD_SIZE - 4; i++) {
+		crc ^= p[i];
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ (crc & 1 ? 0xedb88320U : 0);
+	}
+	return ~crc;
+}
+
+static bool record_matches(const struct xr_recovery_boot *boot, const uint8_t *p)
+{
+	return !memcmp(p, "XRR1", 4) && p[4] == 1 && p[5] == boot->mode &&
+	       p[6] <= 2 && p[7] <= XR_READY && read_be32(p + 8) == boot->seq &&
+	       !memcmp(p + 12, boot->image, sizeof(boot->image)) &&
+	       read_be32(p + 44) == record_crc(p);
+}
+
+static int lock_volume(const char *volume)
+{
+	struct stat st;
+	int fd;
+
+	fd = open(volume, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return -1;
+
+	if (fstat(fd, &st) < 0 || !S_ISCHR(st.st_mode) ||
+	    flock(fd, LOCK_EX | LOCK_NB) < 0) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+static bool record_is(int fd, const uint8_t *expected)
+{
+	uint8_t record[XR_RECORD_SIZE];
+
+	return pread(fd, record, sizeof(record), 0) == sizeof(record) &&
+	       !memcmp(record, expected, sizeof(record));
+}
+
+static bool write_record(int fd, const uint8_t *record)
+{
+	struct ubi_leb_change_req change = { .lnum = 0, .bytes = XR_RECORD_SIZE, .dtype = 3 };
+
+	return !ioctl(fd, UBI_IOCEBCH, &change) &&
+	       write(fd, record, XR_RECORD_SIZE) == XR_RECORD_SIZE &&
+	       !fsync(fd) && record_is(fd, record);
+}
+
+static bool persist_ready(const struct xr_recovery_boot *boot, const char *volume)
+{
+	uint8_t record[XR_RECORD_SIZE];
+	bool success = false;
+	int fd = lock_volume(volume);
+
+	if (fd < 0)
+		return false;
+	if (pread(fd, record, sizeof(record), 0) != sizeof(record) ||
+	    !record_matches(boot, record) || !record_is(fd, record) ||
+	    !xr_recovery_running(boot))
+		goto out;
+
+	if (record[7] != XR_READY) {
+		record[7] = XR_READY;
+		write_be32(record + 44, record_crc(record));
+		if (!write_record(fd, record))
+			goto out;
+	}
+	success = true;
+out:
+	close(fd);
+	return success;
+}
+
+static bool verify_ready(const struct xr_recovery_boot *boot, const char *volume)
+{
+	uint8_t record[XR_RECORD_SIZE];
+	struct stat st;
+	bool verified;
+	int fd = open(volume, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+
+	if (fd < 0)
+		return false;
+	/* A writer already in progress gets to finish. This runs off the event loop. */
+	verified = !fstat(fd, &st) && S_ISCHR(st.st_mode) && !flock(fd, LOCK_SH) &&
+		   pread(fd, record, sizeof(record), 0) == sizeof(record) &&
+		   record_matches(boot, record) && record[7] == XR_READY &&
+		   /* FAILSAFE/READY/0 is the explicit one-shot command. */
+		   (record[5] != XR_FAILSAFE || record[6]);
+	close(fd);
+	return verified;
+}
+
+static bool signal_watchdog(const struct xr_recovery_boot *boot)
+{
+	char tmp[] = XR_RECOVERY_READY ".XXXXXX";
+	size_t len = strlen(boot->token) + 1;
+	int fd = mkstemp(tmp);
+	bool written;
+
+	if (fd < 0)
+		return false;
+	written = write(fd, boot->token, len) == (ssize_t)len;
+	if (close(fd) < 0)
+		written = false;
+	if (written && rename(tmp, XR_RECOVERY_READY) == 0)
+		return true;
+
+	unlink(tmp);
+	return false;
+}
+
+int main(int argc, char **argv)
+{
+	struct xr_recovery_boot boot;
+	bool failsafe;
+
+	if (argc == 3 && !strcmp(argv[1], "verify-ready")) {
+		size_t len;
+
+		if (!xr_recovery_read_boot(&boot) || !verify_ready(&boot, argv[2]))
+			return 1;
+		len = strlen(boot.token) + 1;
+		return write(STDOUT_FILENO, boot.token, len) != (ssize_t)len;
+	}
+
+	if ((argc != 3 && argc != 4) || !xr_recovery_read_boot(&boot))
+		return 1;
+
+	failsafe = !strcmp(argv[2], "failsafe");
+	if (failsafe) {
+		/* A manual preinit failsafe request can override a normal boot. */
+		if (!boot.mode && access("/tmp/.failsafe", F_OK))
+			return 1;
+	} else if (strcmp(argv[2], "normal") || boot.mode) {
+		return 1;
+	}
+
+	if (!xr_recovery_running(&boot))
+		return 1;
+
+	if (argc == 3 && !strcmp(argv[1], "waiting"))
+		return 0;
+	if (argc != 4 || strcmp(argv[1], "ready"))
+		return 1;
+
+	if (!persist_ready(&boot, argv[3])) {
+		fprintf(stderr, "XR1710G: could not record %s readiness\n", argv[2]);
+		return 1;
+	}
+	if (!signal_watchdog(&boot)) {
+		fputs("XR1710G: READY persisted, watchdog notification pending\n", stderr);
+		return 1;
+	}
+
+	fprintf(stderr, "XR1710G: %s ready\n",
+		failsafe && !boot.mode ? "manual failsafe" : argv[2]);
+	return 0;
+}
