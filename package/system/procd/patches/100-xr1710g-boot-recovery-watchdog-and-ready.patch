+static bool recovery_verify_async(void)
+{
+	int result[2];
+	pid_t pid;
+
+	if (pipe2(result, O_CLOEXEC | O_NONBLOCK))
+		return false;
+	pid = fork();
+	if (!pid) {
+		close(result[0]);
+		close(wdt_fd);
+		if (dup2(result[1], STDOUT_FILENO) < 0 ||
+		    fcntl(STDOUT_FILENO, F_SETFD, 0) < 0)
+			_exit(EXIT_FAILURE);
+		if (result[1] != STDOUT_FILENO)
+			close(result[1]);
+		execl("/lib/xr-boot-recovery", "xr-boot-recovery", "verify-ready", NULL);
+		_exit(EXIT_FAILURE);
+	}
+
+	close(result[1]);
+	if (pid < 0) {
+		close(result[0]);
+		return false;
+	}
+	recovery_verify_fd = result[0];
+	return true;
+}
+
+static bool recovery_can_ping(void)
+{
+	char token[sizeof(recovery_boot.token)];
+	ssize_t n;
+	int fd;
+
+	if (!recovery_pending)
+		return true;
+	if (recovery_expired)
+		return false;
+
+	if (recovery_verify_fd >= 0) {
+		n = read(recovery_verify_fd, token, sizeof(token));
+		if (n < 0 && (errno == EAGAIN || errno == EINTR))
+			return false;
+		close(recovery_verify_fd);
+		recovery_verify_fd = -1;
+		if (n == (ssize_t)strlen(recovery_boot.token) + 1 &&
+		    !memcmp(token, recovery_boot.token, n)) {
+			recovery_pending = false;
+			return true;
+		}
+		goto expire;
+	}
+
+	fd = open(XR_RECOVERY_READY, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC);
+	if (fd >= 0) {
+		n = read(fd, token, sizeof(token));
+		close(fd);
+		if (n == (ssize_t)strlen(recovery_boot.token) + 1 &&
+		    !memcmp(token, recovery_boot.token, n)) {
+			recovery_pending = false;
+			return true;
+		}
+	}
+
+	if (xr_recovery_running(&recovery_boot))
+		return true;
+	/* A lost tmpfs notification must not block the watchdog event loop. */
+	if (recovery_verify_async())
+		return false;
+
+expire:
+	LOG("XR1710G boot readiness deadline expired; leaving watchdog armed\n");
+	recovery_expired = true;
+	return false;
+}
+#endif
