#!/bin/sh /etc/rc.common
START=03
STOP=99
USE_PROCD=1
start_service() {
 local tool=/usr/libexec/dicttech-ap/transaction
 "$tool" early || return 1
 [ -d /root/.dicttech-ap-transaction ] || return 0
 if [ -f /root/.dicttech-ap-transaction/services-restore-pending ]; then
  procd_open_instance finish-rollback
  procd_set_param command "$tool" finish-rollback
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
 fi
 [ ! -f /root/.dicttech-ap-transaction/confirmed ] || return 0
 [ ! -f /root/.dicttech-ap-transaction/rolled-back ] || return 0
 procd_open_instance rollback
 procd_set_param command "$tool" watch
 procd_set_param respawn 3600 2 10
 procd_set_param term_timeout 5
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
