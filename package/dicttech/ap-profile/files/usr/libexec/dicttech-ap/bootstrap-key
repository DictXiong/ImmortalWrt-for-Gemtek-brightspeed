#!/bin/sh
# Initialization authentication lifecycle; retains its legacy path for upgrades.
# Fresh setup uses root/password, never an installation-specific private key.
set -eu
umask 077
SYSROOT=
BOOT=/proc/sys/kernel/random/boot_id
JQ=/usr/bin/jq
p() { printf '%s%s' "$SYSROOT" "$1"; }
LIFE=$(p /etc/dicttech-ap-bootstrap-key)
STATE=$LIFE/state
AUTH=$(p /etc/dropbear/authorized_keys)
KEY=$(p /usr/share/dicttech-ap/bootstrap-authorized-key.pub)
OWNER=$(p /usr/share/dicttech-cli/authorized_keys)
TX=$(p /root/.dicttech-ap-transaction)
GENERIC_TX=$(p /root/.openwrt-deploy/state)
PASSWORD=$(p /usr/share/dicttech-ap/bootstrap-password-hash)
SHADOW=$(p /etc/shadow)
plain() { test -f "$1" && test ! -L "$1"; }
private() { plain "$1" && test "$(ls -nd "$1" | awk '{print $1 ":" $3}')" = '-rw-------:0'; }
state() {
 private "$STATE" || return 1
 test "$(wc -l < "$STATE" | tr -d ' ')" = 1 || return 1
 IFS= read -r value < "$STATE"
 case "$value" in fresh|retired) printf '%s\n' "$value";; *) return 1;; esac
}
write_state() {
 test ! -L "$LIFE" && test ! -L "$STATE" || return 1
 if test "$(state 2>/dev/null || true)" = "$1"; then return 0; fi
 mkdir -p "$LIFE"; chmod 700 "$LIFE"
 test ! -e "$STATE.new.$$" && test ! -L "$STATE.new.$$" || return 1
 (set -C; printf '%s\n' "$1" > "$STATE.new.$$"); chmod 600 "$STATE.new.$$"
 mv "$STATE.new.$$" "$STATE"
}
filter() {
 # Classify only the actual key fields, never a pair in another key's comment.
 # One optional options field may contain quoted spaces; no shell evaluation.
 test "$(wc -l < "$KEY" | tr -d ' ')" = 1 || return 1
 awk 'NR==FNR {if(FNR==1){kind=$1;blob=$2}next}
 /^[[:space:]]*#/ {print;next}
 {
  n=0;word="";quoted=0;escape=0;delete fields
  for(i=1;i<=length($0);i++) {
   c=substr($0,i,1)
   if(escape){word=word c;escape=0;continue}
   if(c=="\\"){escape=1;continue}
   if(c=="\""){quoted=!quoted;continue}
   if(c~/[[:space:]]/ && !quoted){if(length(word)){fields[++n]=word;word="";if(n==3 || (n==2 && fields[1]~/^(ssh-|ecdsa-|sk-)/))break}}else word=word c
  }
  if(length(word) && n<3)fields[++n]=word
  if(!quoted && !escape && ((fields[1]==kind && fields[2]==blob) || (fields[2]==kind && fields[3]==blob)))next
  print
 }' "$KEY" "$1"
}
strip() {
 plain "$KEY" || return 1
 if test ! -e "$AUTH" && test ! -L "$AUTH"; then return 0; fi
 if test -L "$AUTH"; then rm "$AUTH"; return 0; fi
 plain "$AUTH" && test ! -L "${AUTH%/*}" && test "$(ls -nd "$AUTH" | awk '{print $3}')" = 0 || return 1
 test ! -e "$AUTH.new.$$" && test ! -L "$AUTH.new.$$" || return 1
 (set -C; filter "$AUTH" > "$AUTH.new.$$"); chmod 600 "$AUTH.new.$$"
 if cmp -s "$AUTH" "$AUTH.new.$$"; then rm "$AUTH.new.$$"; else mv "$AUTH.new.$$" "$AUTH"; fi
}
password_default() {
 private "$SHADOW" && plain "$PASSWORD" || return 1
 test "$(awk -F: '$1=="root" {print $2}' "$SHADOW")" = "$(cat "$PASSWORD")"
}
password_material() {
 private "$1" && test "$(wc -l < "$1" | tr -d ' ')" = 1 || return 1
 case "$(cat "$1")" in '$6$'*|'$5$'*|'$y$'*) :;; *) return 1;; esac
 case "$(cat "$1")" in *:*|*' '*|*"$(printf '\t')"*) return 1;; esac
}
set_password() {
 private "$SHADOW" || return 1
 test "$(awk -F: '$1=="root" {n++} END {print n+0}' "$SHADOW")" = 1 || return 1
 test ! -e "$SHADOW.new.$$" && test ! -L "$SHADOW.new.$$" || return 1
 (set -C; awk 'BEGIN {FS=OFS=":"} FNR==NR {hash=$0;next} $1=="root" {$2=hash} {print}' "$1" "$SHADOW" > "$SHADOW.new.$$") || return 1
 chmod 600 "$SHADOW.new.$$"; mv "$SHADOW.new.$$" "$SHADOW"
}
retire() {
 # This tombstone is outside the removable/quarantined managed profile.
 # Only retire an existing initialization password, never reset a configured one.
 if test "$(state 2>/dev/null || true)" != retired && password_default; then
  if password_material "$(p /etc/dicttech-ap/root-password-hash)"; then
   set_password "$(p /etc/dicttech-ap/root-password-hash)"
  else printf '!\n' | set_password -; fi
 fi
 strip
 write_state retired
 sync
}
pending() {
 test "$(state 2>/dev/null || true)" = fresh || return 1
 if test -d "$TX" && test ! -L "$TX" && private "$TX/manifest.json" &&
    test ! -e "$TX/confirmed" && test ! -e "$TX/rolled-back" &&
    { plain "$TX/applying" || plain "$TX/applied"; } &&
    "$JQ" -e --arg boot "$(cat "$BOOT")" '.approved_target.initialize==true and .boot_id==$boot' "$TX/manifest.json" >/dev/null; then return 0; fi
 # Nix has its own journal and one planned candidate boot. No new credential
 # is granted here: the fresh password must already exist in shadow.
 test -d "$GENERIC_TX" && test ! -L "$GENERIC_TX" && private "$GENERIC_TX/manifest.json" && private "$GENERIC_TX/lease" || return 1
 test ! -e "$GENERIC_TX/confirmed" && test ! -e "$GENERIC_TX/rolled-back" || return 1
 plain "$GENERIC_TX/applying" || plain "$GENERIC_TX/applied" || return 1
 "$JQ" -e '.schema_version==1 and .profile_ap==true and .initialize==true and (.token|type=="string" and length==32)' "$GENERIC_TX/manifest.json" >/dev/null || return 1
 local origin deadline stamp current
 read -r origin deadline < "$GENERIC_TX/lease"
 case "$deadline" in ''|*[!0-9]*) return 1;; esac
 test "$origin" = "$("$JQ" -r .boot_id "$GENERIC_TX/manifest.json")" || return 1
 current=$(cat "$BOOT"); stamp=$(cut -d. -f1 "$(p /proc/uptime)")
 if test "$origin" = "$current"; then test "$stamp" -lt "$deadline"; return; fi
 private "$GENERIC_TX/reboot.json" || return 1
 "$JQ" -e --arg origin "$origin" --arg current "$current" --argjson stamp "$stamp" --argjson deadline "$deadline" --slurpfile manifest "$GENERIC_TX/manifest.json" '
  .schema_version==1 and .token==$manifest[0].token and .origin_boot_id==$origin and .origin_deadline==$deadline and
  (if .state=="armed" then $stamp<180
   elif .state=="awaiting-resume" then .boot_id==$current and $stamp<180
   elif .state=="resumed" then .boot_id==$current and (.deadline|type=="number") and $stamp<.deadline
   else false end)' "$GENERIC_TX/reboot.json" >/dev/null
}
case "${1:-}" in
 fresh)
  # Only bootstrap's fully installed no-marker setup calls this operation.
  test ! -e "$(p /etc/dicttech-ap/device.json)" && test ! -L "$(p /etc/dicttech-ap/device.json)" || exit 1
  if test -L "$LIFE"; then strip; exit 1; fi
  if test -e "$STATE" || test -L "$STATE"; then
   # A prior grant is not permission to undo manual removal or explicit [].
   if test "$(state 2>/dev/null || true)" = fresh; then exit 0; fi
   retire; exit
  elif test -e "$(p /root/dicttech-ap-quarantine)" || test -L "$(p /root/dicttech-ap-quarantine)"; then
   retire; exit
  else
   private "$SHADOW" && plain "$PASSWORD" || exit 1
   case "$(awk -F: '$1=="root" {print $2}' "$SHADOW")" in ''|'!'|'*') :;; *) retire; exit;; esac
   set_password "$PASSWORD"
   write_state fresh; sync
  fi
  # Keep explicit owner/empty-key policies, removing only the old bootstrap key.
  strip
  ;;
 managed)
  # Pending initialization may retain an existing grant, never grant it anew.
  if pending; then exit 0; fi
  retire;;
 retire) retire;;
 password-pending) password_default && pending;;
 *) printf 'usage: bootstrap-key fresh|managed|retire|password-pending\n' >&2; exit 2;;
esac
