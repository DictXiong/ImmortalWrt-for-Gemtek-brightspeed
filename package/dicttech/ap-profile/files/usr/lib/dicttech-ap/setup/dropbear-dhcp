config dropbear 'setup'
	option DirectInterface 'ap_maintenance'
	option Port '12022'
	option PasswordAuth 'on'
	option RootPasswordAuth 'on'
	option RootLogin 'on'
	option GatewayPorts 'off'

# The DHCP uplink accepts owner public keys only, never the setup password.
config dropbear 'bootstrap'
	option DirectInterface 'bootstrap'
	option Port '12022'
	option PasswordAuth 'off'
	option RootPasswordAuth 'off'
	option RootLogin 'on'
	option GatewayPorts 'off'
