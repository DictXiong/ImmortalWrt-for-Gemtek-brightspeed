config defaults
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option flow_offloading '0'
	option flow_offloading_hw '0'

config zone 'setup'
	option name 'setup'
	list network 'ap_maintenance'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'

config rule 'setup_management'
	option name 'Wired setup management'
	option src 'setup'
	option proto 'tcp'
	option dest_port '80 12022'
	option target 'ACCEPT'

config rule 'setup_ping'
	option name 'Wired setup IPv4 ping'
	option src 'setup'
	option family 'ipv4'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option target 'ACCEPT'

config zone 'bootstrap'
	option name 'bootstrap'
	list network 'bootstrap'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'

config rule 'bootstrap_ssh'
	option name 'Owner key setup SSH'
	option src 'bootstrap'
	option proto 'tcp'
	option dest_port '12022'
	option target 'ACCEPT'

config rule 'bootstrap_dhcp'
	option name 'Setup DHCP client'
	option src 'bootstrap'
	option family 'ipv4'
	option proto 'udp'
	option src_port '67'
	option dest_port '68'
	option target 'ACCEPT'

config rule 'bootstrap_icmp'
	option name 'Setup IPv4 ICMP'
	option src 'bootstrap'
	option family 'ipv4'
	option proto 'icmp'
	list icmp_type 'echo-request'
	list icmp_type 'destination-unreachable'
	list icmp_type 'time-exceeded'
	list icmp_type 'parameter-problem'
	option target 'ACCEPT'
