config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# LAN4 stays separate: identical offline addresses never enter the uplink.
config interface 'ap_maintenance'
	option device 'lan4'
	option proto 'static'
	option ipaddr '192.168.250.1'
	option netmask '255.255.255.0'
	option delegate '0'
	option ipv6 '0'

config device 'setup_bridge'
	option name 'br-setup'
	option type 'bridge'
	option bridge_empty '1'
	option vlan_filtering '1'
	option ipv6 '0'
	option macaddr '@BOOTSTRAP_MAC@'
	list ports 'wan'
	list ports 'lan2'
	list ports 'lan3'

config bridge-vlan 'setup_native'
	option device 'br-setup'
	option vlan '1'
	option local '1'
	list ports 'wan:u*'
	list ports 'lan2:u*'
	list ports 'lan3:u*'

config device 'setup_vlan'
	option name 'br-setup.1'
	option type '8021q'
	option ifname 'br-setup'
	option vid '1'
	option ipv6 '0'

config interface 'bootstrap'
	option device 'br-setup.1'
	option proto 'dhcp'
	option hostname '@BOOTSTRAP_HOSTNAME@'
	option sendclientid 'hardware'
	option delegate '0'
	option ipv6 '0'
