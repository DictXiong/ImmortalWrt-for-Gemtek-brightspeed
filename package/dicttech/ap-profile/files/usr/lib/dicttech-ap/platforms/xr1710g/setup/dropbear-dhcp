config dropbear 'setup'
	option DirectInterface 'ap_maintenance'
	option Port '12022'
	option PasswordAuth 'on'
	option RootPasswordAuth 'on'
	option RootLogin 'on'
	option GatewayPorts 'off'

# Fresh DHCP and offline setup both accept root/password until enrollment confirms.
config dropbear 'bootstrap'
	option DirectInterface 'bootstrap'
	option Port '12022'
	option PasswordAuth 'on'
	option RootPasswordAuth 'on'
	option RootLogin 'on'
	option GatewayPorts 'off'
