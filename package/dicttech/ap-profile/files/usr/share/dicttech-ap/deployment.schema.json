{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dicttech:openwrt:configuration:v3",
  "title": "Complete OpenWrt resource document",
  "description": "Producer-owned complete configuration; the runtime validator additionally enforces byte limits, safe paths, address ownership, wireless/UCI consistency, platform capacity and cross-device policy. No presets or address allocation.",
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
    },
    "uciName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
      "maxLength": 255
    },
    "iface": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,15}$"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$"
    },
    "ipv4": {
      "type": "string",
      "format": "ipv4"
    },
    "scalar": {
      "type": [
        "string",
        "integer",
        "boolean"
      ]
    },
    "uciSection": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/uciName"
        },
        "anonymous": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                },
                "minItems": 0,
                "maxItems": 256
              }
            ]
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_]+$",
            "maxLength": 255
          }
        }
      },
      "required": [
        "type",
        "options"
      ],
      "additionalProperties": false
    },
    "uci": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/uciSection"
        },
        "maxProperties": 256,
        "propertyNames": {
          "pattern": "^[A-Za-z0-9_]+$",
          "maxLength": 255
        }
      },
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
        "maxLength": 255
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "bridge": {
          "$ref": "#/$defs/mac"
        },
        "ethernet": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mac"
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.:-]{1,15}$"
          }
        },
        "radios": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mac"
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
          }
        },
        "mlds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mac"
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
          }
        },
        "bssids": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mac"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
          }
        },
        "duid": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{2}){4,64}$"
        }
      },
      "required": [
        "bridge",
        "ethernet",
        "radios",
        "mlds",
        "bssids",
        "duid"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "board_names": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_,.+-]+$"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "max_ap_per_radio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_mlds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "mac_prefix_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/iface"
            },
            "minItems": 2,
            "maxItems": 256,
            "uniqueItems": true
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "board_names"
      ],
      "additionalProperties": true
    },
    "ssid": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/token"
        },
        "section": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$",
          "maxLength": 255
        },
        "iface": {
          "$ref": "#/$defs/iface"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "bands": {
          "type": "array",
          "items": {
            "enum": [
              "2g",
              "5g",
              "6g"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "mlo": {
          "type": "boolean"
        },
        "network": {
          "$ref": "#/$defs/uciName"
        },
        "encryption": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]*$"
        },
        "pmf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "eht": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "roaming": {
          "type": "boolean"
        },
        "radios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "link_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "bssids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mac"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "mld_mac": {
          "$ref": "#/$defs/mac"
        }
      },
      "required": [
        "key",
        "section",
        "iface",
        "name",
        "bands",
        "mlo",
        "network",
        "encryption",
        "pmf",
        "eht",
        "hidden",
        "roaming",
        "radios",
        "link_ids",
        "bssids"
      ],
      "additionalProperties": false
    },
    "peer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "address": {
          "$ref": "#/$defs/ipv4"
        },
        "bridge_mac": {
          "$ref": "#/$defs/mac"
        },
        "bssids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mac"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "address",
        "bridge_mac",
        "bssids"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "running": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "oneshot": {
          "type": "boolean"
        },
        "reloadOn": {
          "type": "object",
          "properties": {
            "uci": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uciName"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0,
              "maxItems": 256
            }
          },
          "required": [
            "uci",
            "files"
          ],
          "additionalProperties": false
        },
        "action": {
          "enum": [
            "reload",
            "restart"
          ]
        }
      },
      "required": [
        "enable",
        "running",
        "reloadOn"
      ],
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "properties": {
        "root_password_hash": {
          "type": "string",
          "description": "Runtime validator requires a SHA-256/SHA-512 crypt hash."
        },
        "authorized_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "root_password_hash"
      ],
      "additionalProperties": false
    },
    "file": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 131072
        },
        {
          "type": "object",
          "properties": {
            "content_base64": {
              "type": "string",
              "contentEncoding": "base64",
              "maxLength": 174764
            },
            "mode": {
              "enum": [
                "600",
                "644",
                "700",
                "755"
              ]
            }
          },
          "required": [
            "content_base64",
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resolver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 2,
              "maxLength": 1024,
              "pattern": "^/[A-Za-z0-9_./-]+$"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
        },
        "management_ipv4": {
          "$ref": "#/$defs/ipv4"
        },
        "maintenance_ipv4": {
          "$ref": "#/$defs/ipv4"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "common": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^([A-Z]{2}|00)$"
            },
            "ssh_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "timezone": {
              "type": "string"
            },
            "zonename": {
              "type": "string"
            },
            "ntp_servers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0,
              "maxItems": 64
            },
            "radios": {
              "type": "object"
            },
            "roaming": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "ssids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ssid"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/peer"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/service"
          },
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
            "maxLength": 255,
            "not": {
              "enum": [
                "dicttech-ap-transaction",
                "dicttech-ap-prepare",
                "dicttech-ap-finalize",
                "openwrt-deploy-guard"
              ]
            }
          }
        },
        "uci": {
          "$ref": "#/$defs/uci"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/file"
          },
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_./-]+$",
            "maxLength": 4096
          }
        },
        "resolver": {
          "$ref": "#/$defs/resolver"
        },
        "credentials": {
          "$ref": "#/$defs/credentials"
        }
      },
      "required": [
        "hostname",
        "management_ipv4",
        "maintenance_ipv4",
        "ssh_port",
        "identity",
        "platform",
        "common",
        "ssids",
        "peers",
        "services",
        "uci",
        "files",
        "resolver",
        "credentials"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "profile": {
      "const": "openwrt-config-v3"
    },
    "devices": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      },
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
      },
      "minProperties": 1
    }
  },
  "required": [
    "schema_version",
    "profile",
    "devices"
  ],
  "additionalProperties": false
}
