# Device provisioning supplies peer addresses, bridge identities and permitted
# per-link BSSIDs. No Wi-Fi keys or deployment identities belong in this package.
# All instances are disabled until that configuration has been validated.

config roaming 'main'
	option enabled '0'
	option section 'dicttech_mlo'
	option iface 'ap-mld1'
	option interval '30'
	option ttl '180'

config roaming 'battalion'
	option enabled '0'
	option section 'default_radio1'
	option iface 'ap-mld0'
	option interval '30'
	option ttl '180'

config roaming 'guest'
	option enabled '0'
	option section 'guest_mlo'
	option iface 'ap-mld2'
	option interval '30'
	option ttl '180'

config roaming 'iot'
	option enabled '0'
	option section 'wifinet1'
	option iface 'phy0.0-ap1'
	option interval '30'
	option ttl '180'
