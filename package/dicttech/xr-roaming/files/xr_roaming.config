# Device provisioning supplies peer addresses, bridge identities and permitted
# per-link BSSIDs. No Wi-Fi keys or deployment identities belong in this package.
# All instances are disabled until that configuration has been validated.

config roaming 'main'
	option enabled '0'
	option section 'ssid_main'
	option iface 'ap-mld0'
	option mlo '1'
	option max_links '3'
	option interval '30'
	option ttl '180'

config roaming 'guest'
	option enabled '0'
	option section 'ssid_guest'
	option iface 'ap-mld1'
	option mlo '1'
	option max_links '2'
	option interval '30'
	option ttl '180'

config roaming 'iot'
	option enabled '0'
	option section 'ssid_iot'
	option iface 'ap-iot'
	option mlo '0'
	option max_links '1'
	option interval '30'
	option ttl '180'
