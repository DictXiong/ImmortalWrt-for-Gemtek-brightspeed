#!/bin/sh /etc/rc.common
# Copyright (c) 2014 OpenWrt.org

START=80

USE_PROCD=1
PROG=/usr/sbin/umdns
IFACES=""

do_reload_service() {
	local network="$(uci -q get umdns.@umdns[-1].network)"
	local previous n device address kind known payload

	json_set_namespace umdns_request_ previous
	json_init
	json_add_array interfaces
	json_close_array
	json_add_object ipv4_sources
	json_close_object

	for n in $network; do
		json_set_namespace umdns_status_
		json_load "$(ifstatus "$n")"
		json_get_var device l3_device
		address=
		json_get_type kind ipv4-address
		if [ "$kind" = array ] && json_select ipv4-address && json_select 1; then
			json_get_var address address
		fi
		json_cleanup
		[ -n "$device" ] || continue

		json_set_namespace umdns_request_
		json_select ipv4_sources
		json_get_type kind "$device"
		json_get_var known "$device"
		if [ "$kind" != string ] || [ -z "$known" ]; then
			json_add_string "$device" "$address"
		fi
		json_select ..
		if [ "$kind" != string ]; then
			json_select interfaces
			json_add_string "" "$device"
			json_select ..
		fi
	done

	json_set_namespace umdns_request_
	payload=$(json_dump)
	json_cleanup
	json_set_namespace "$previous"
	ubus call umdns set_config "$payload"
}

start_service() {
	local network="$(uci -q get umdns.@umdns[-1].network)"

	procd_open_instance
	procd_set_param command "$PROG"
	[ -f /etc/seccomp/umdns.json ] && procd_set_param seccomp /etc/seccomp/umdns.json
	procd_set_param respawn

	procd_open_data
	json_add_array firewall

	for n in $network; do
		json_add_object ""
		json_add_string type rule
		json_add_string proto udp
		json_add_string src "$n"
		json_add_int dest_port 5353
		json_add_string target ACCEPT
		json_close_object
	done

	json_close_array
	procd_close_data

	procd_open_trigger
	procd_add_config_trigger "config.change" "umdns" /etc/init.d/umdns reload
	for n in $network; do
		procd_add_interface_trigger "interface.*" $n /etc/init.d/umdns reload
	done
	procd_add_raw_trigger "instance.update" 5000 "/bin/ubus" "call" "umdns" "reload"
	procd_close_trigger
	[ "$(uci get umdns.@umdns[-1].jail)" = 1 ] && {
		procd_add_jail umdns ubus log udebug
		[ -d /etc/umdns ] && procd_add_jail_mount "/etc/umdns"
	}
	procd_close_instance
}

reload_service() {
	rc_procd start_service
	do_reload_service
}

service_running() {
	ubus -t 10 wait_for umdns
	[ $? = 0 ] && do_reload_service
}
